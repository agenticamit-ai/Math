# Postgres connection string. On Neon, use the pooled connection string.
DATABASE_URL=postgres://readup:readup@localhost:5432/readup

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# Optional. Without it, summaries are scored by a simple keyword check instead of Claude.
ANTHROPIC_API_KEY=

# Optional. Comma-separated emails allowed to create a parent account.
# Leave empty to allow anyone who finds the URL to sign up.
ALLOWED_PARENT_EMAILS=
