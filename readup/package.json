{
  "name": "readup",
  "version": "0.1.0",
  "private": true,
  "description": "ReadUp: reading speed and comprehension practice for a middle-school reader.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "validate": "tsx scripts/validate-content.ts",
    "vercel-build": "npm run db:migrate && npm run seed && next build",
    "test": "tsx scripts/test-logic.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "next": "^15.5.4",
    "postgres": "^4.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
